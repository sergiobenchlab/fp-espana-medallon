# Copiar a .env (con punto delante) y rellenar. NUNCA subir el .env al repositorio.

PGHOST=localhost
PGPORT=5432
PGDATABASE=benchlab_fp_es
PGUSER=
PGPASSWORD=

# Cadena completa (usada por los scripts de ingesta y el bucle psql del README)
DATABASE_URL=postgresql://usuario:password@localhost:5432/benchlab_fp_es

# Ruta local a los ficheros descargados de EDUCAbase y Dualiza
RUTA_DATOS_RAW=./data/raw
